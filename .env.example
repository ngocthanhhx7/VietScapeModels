# ==============================================================================
# VietScape Models (Đồ án khởi nghiệp EXE101) - Biến Môi Trường Cấu Hình Email
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env và điền các khóa từ https://dashboard.emailjs.com/
# Chi tiết các bước xem tại: README_EMAIL_SETUP.md
# ==============================================================================

# 1. Service ID của Gmail Service trên EmailJS (Ví dụ: service_vietscape hoặc service_gmail)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

# 2. Template ID mẫu email thông báo đơn hàng (Ví dụ: template_order_inquiry)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# 3. Public Key của tài khoản EmailJS (Account > General > Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# 4. Hòm thư Gmail quản trị tiếp nhận đơn hàng của nhóm dự án
VITE_ADMIN_RECEIVER_EMAIL=vietscapemodels@gmail.com
